<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Root ကို StackPane သုံးထားလို့ Window ဘယ်လောက်ချဲ့ချဲ့ အလယ်မှာပဲ ရှိနေပါမယ် -->

<StackPane prefHeight="596.0" prefWidth="801.0" styleClass="root-pane" stylesheets="@forgot_password.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RVController.OTPVerificationController">

    <!-- Card တစ်ခုလုံးကို VBox နဲ့ တည်ဆောက်ခြင်း -->
    <VBox alignment="CENTER" maxWidth="674.0" minWidth="380.0" prefHeight="433.0" prefWidth="621.0" spacing="20.0" style="-fx-border-radius: 12px; -fx-background-radius: 12px; -fx-border-color: linear-gradient(to right,#16243a,#f38983); -fx-border-width: 3px; -fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 8);">
        <padding>
            <Insets bottom="15.0" left="30.0" right="30.0" top="15.0" />
        </padding>
      <VBox prefHeight="90.0" prefWidth="566.0">
         <children>
               <Label prefHeight="58.0" prefWidth="287.0" styleClass="title-text" text="Forget Password" textFill="#f39838">
                  <font>
                     <Font name="System Bold" size="24.0" />
                  </font>
                  <opaqueInsets>
                     <Insets />
                  </opaqueInsets>
                  <padding>
                     <Insets left="50.0" />
                  </padding>
                  <effect>
                  <DropShadow color="#ffce9d" height="33.44" radius="23.995" width="64.54" />
                  </effect>
               <VBox.margin>
                  <Insets left="150.0" />
               </VBox.margin>
               </Label>
               <Label styleClass="subtitle-text" text="Please Select option to send link reset password" textFill="GREEN">
               <VBox.margin>
                  <Insets left="150.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
      <TextField fx:id="txtOtpcode" prefHeight="31.0" prefWidth="544.0" promptText="OTP Code" style="-fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 10px; -fx-background-color: #F8FAFC;" />

        <!-- Send Link Button -->
        <Button fx:id="btnSend" maxWidth="Infinity" onAction="#clickSend" style="-fx-text-fill: #F39838; -fx-background-color: #16243a; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-border-color: #F39838; -fx-font-weight: bold; -fx-underline: false;" text="Send" />
      <Label fx:id="lblTimer" text="1:00" />

        <!-- Footer Link -->
        <HBox alignment="CENTER" spacing="4.0">
            <Label styleClass="footer-text" text="Didn't receive link?" textFill="#16243a" />
            <Hyperlink fx:id="hlResend" onAction="#clickResend" styleClass="resend-link" text="Resend" textFill="#f39838">
            <font>
               <Font name="System Bold" size="15.0" />
            </font></Hyperlink>
        </HBox>
      <StackPane.margin>
         <Insets bottom="100.0" left="50.0" right="50.0" top="100.0" />
      </StackPane.margin>
    </VBox>
   <padding>
      <Insets bottom="50.0" left="30.0" right="30.0" top="50.0" />
   </padding>

</StackPane>
