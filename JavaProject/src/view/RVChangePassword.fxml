<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Root ကို StackPane သုံးထား၍ Window ဘယ်လောက်ချဲ့ချဲ့ အလယ်ဗဟိုမှာ ရှိနေပါမည် -->

<StackPane prefHeight="497.0" prefWidth="707.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RVController.ChangePasswordController">

    <!-- Card တစ်ခုလုံးကို VBox ဖြင့် တည်ဆောက်ခြင်း -->
    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="528.0" prefHeight="497.0" prefWidth="400.0" spacing="18.0" style="-fx-border-radius: 12px; -fx-background-radius: 12px; -fx-border-color: linear-gradient(to right,#16243a,#f38983); -fx-border-width: 3px; -fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 8);">
        <padding>
            <Insets bottom="10.0" left="40.0" right="40.0" top="10.0" />
        </padding>
        
        <!-- Header & Description -->
        <VBox alignment="CENTER" spacing="8.0">
            <Label prefHeight="58.0" prefWidth="287.0" styleClass="title-text" text="Reset Password" textFill="#f39838">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
            <padding>
               <Insets left="50.0" />
            </padding>
            <effect>
               <DropShadow color="#ffce9d" height="33.44" radius="23.995" width="64.54" />
            </effect></Label>
            <Label styleClass="subtitle-text" text="If you want to reset your password, please enter your new password below." textAlignment="CENTER" textFill="GREEN" wrapText="true" />
        </VBox>

        <!-- New Password Field -->
        <VBox spacing="6.0" styleClass="input-container">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #16243A;" styleClass="label-text" text="New password" />
            <PasswordField fx:id="txtPassword" promptText="Enter new password" style="-fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 10px; -fx-background-color: #F8FAFC;" />
        </VBox>

        <!-- Confirm Password Field -->
        <VBox spacing="6.0" styleClass="input-container">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #16243A;" styleClass="label-text" text="Confirm password" />
            <PasswordField fx:id="txtConfirmPassword" promptText="Confirm new password" style="-fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 10px; -fx-background-color: #F8FAFC;" />
        </VBox>

        <!-- Change Password Button -->
        <Button fx:id="btnChangePassword" maxWidth="Infinity" onAction="#clickChangePassword" prefHeight="39.0" prefWidth="413.0" style="-fx-text-fill: #F39838; -fx-background-color: #16243a; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-border-color: #F39838; -fx-font-weight: bold; -fx-underline: false;" text="Change password →" />

        <!-- Footer Text -->
        <Label styleClass="footer-text" text="If you didn't request a password recovery link, please ignore this." textAlignment="CENTER" textFill="GREEN" wrapText="true" />
      <StackPane.margin>
         <Insets bottom="50.0" top="50.0" />
      </StackPane.margin>
    </VBox>

</StackPane>
