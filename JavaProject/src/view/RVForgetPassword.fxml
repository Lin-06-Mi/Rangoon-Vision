<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Root ကို StackPane သုံးထားလို့ Window ဘယ်လောက်ချဲ့ချဲ့ အလယ်မှာပဲ ရှိနေပါမယ် -->

<StackPane prefHeight="643.0" prefWidth="945.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RVController.ForgotPasswordController">

                <!-- Card တစ်ခုလုံးကို VBox နဲ့ တည်ဆောက်ခြင်း -->
    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="775.0" minWidth="300.0" prefHeight="473.0" prefWidth="716.0" spacing="18.0" style="-fx-border-radius: 12px; -fx-background-radius: 12px; -fx-border-color: linear-gradient(to right,#16243a,#f38983); -fx-border-width: 3px; -fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 8);">
        
                       <!-- Header Section -->
        <VBox alignment="CENTER" spacing="8.0">
             <Label prefHeight="58.0" prefWidth="287.0" styleClass="title-text" text="Forget Password" textFill="#f39838">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
            <padding>
               <Insets left="50.0" />
            </padding>
            <effect>
               <DropShadow color="#ffce9d" height="33.44" radius="23.995" width="64.54" />
            </effect>
         </Label>
            <Label styleClass="subtitle-text" text="Please Select option to send link reset password" textFill="GREEN" />
         <VBox.margin>
            <Insets left="30.0" right="30.0" top="20.0" />
         </VBox.margin>
        </VBox>

                          <!-- Option 2: Reset via SMS -->
        <HBox alignment="CENTER_LEFT" prefHeight="125.0" prefWidth="729.0" spacing="15.0" styleClass="option-card">
            <padding>
                <Insets bottom="15.0" left="15.0" top="15.0" />
            </padding>
            
                              <Label prefHeight="62.0" prefWidth="39.0" styleClass="icon-box" text="✉">
            <HBox.margin>
               <Insets right="20.0" />
            </HBox.margin>
            <font>
               <Font size="28.0" />
            </font>
         </Label>
            
                              <VBox alignment="CENTER_LEFT" prefHeight="95.0" prefWidth="605.0" spacing="3.0">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16243A;" styleClass="option-title" text="Reset via Email" />
                <Label prefHeight="10.0" prefWidth="468.0" styleClass="option-subtitle" text="Link reset will be send to your phone number registered" textFill="GREEN" wrapText="true" />
            <TextField prefHeight="43.0" prefWidth="591.0" promptText="Enter your email" style="-fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 10px; -fx-background-color: #F8FAFC;" />
            <HBox.margin>
               <Insets />
            </HBox.margin>
            </VBox>
         <Region prefHeight="66.0" prefWidth="0.0" />
         <VBox.margin>
            <Insets left="40.0" right="40.0" />
         </VBox.margin>
        </HBox>

                          <!-- Send Link Button -->
        <Button fx:id="btnSendLink" maxWidth="Infinity" onAction="#clickSendLink" prefHeight="39.0" prefWidth="636.0" style="-fx-text-fill: #F39838; -fx-background-color: #16243a; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-border-color: #F39838; -fx-font-weight: bold; -fx-underline: false;" text="Send ">
         <VBox.margin>
            <Insets left="40.0" right="40.0" />
         </VBox.margin>
      </Button>

                       <!-- Footer Link -->
        <HBox alignment="CENTER" spacing="4.0">
            <Label styleClass="footer-text" text="Didn't receive link?" textFill="#16243a" />
            <Hyperlink fx:id="hlresend" onAction="#clickResend" styleClass="resend-link" text="Resend" textFill="#f39838">
            <font>
               <Font name="System Bold" size="15.0" />
            </font>
         </Hyperlink>
         <VBox.margin>
            <Insets left="30.0" right="30.0" />
         </VBox.margin>
        </HBox>
      <StackPane.margin>
         <Insets bottom="85.0" left="50.0" right="50.0" top="85.0" />
      </StackPane.margin>
    </VBox>
   <padding>
      <Insets left="30.0" right="30.0" />
   </padding>

</StackPane>
