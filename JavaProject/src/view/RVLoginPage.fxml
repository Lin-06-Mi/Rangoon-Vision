<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootStack" prefHeight="764.0" prefWidth="1018.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RVController.RVHomePageController">

    <children>

        <AnchorPane prefHeight="827.0" prefWidth="1018.0">
            <children>

                <Region fx:id="bgRegion" prefHeight="825.0" prefWidth="1018.0" style="-fx-background-color: #FFFFFF;" AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

                <Circle fill="#F39821" layoutX="-13.0" layoutY="284.0" radius="437.0" rotate="36.0" />

                <Circle fill="#16243a" layoutX="37.0" layoutY="206.0" radius="345.0" rotate="-19.3" />

            </children>
        </AnchorPane>

                                                                                <VBox alignment="CENTER" prefHeight="754.0" prefWidth="1018.0" spacing="25.0" StackPane.alignment="CENTER">

                                                                                    <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

                                                                                    <children>

                                                                                        <AnchorPane maxHeight="100.0" maxWidth="289.0" minHeight="100.0" minWidth="259.0" prefHeight="100.0" prefWidth="289.0">

                                                                                            <children>

                                                                                                <Label fx:id="lblLogoTitle" layoutX="25.0" layoutY="10.0" prefHeight="54.0" prefWidth="253.0" text="Rangoon " textFill="#16243a">
                            <font>
                                <Font name="Felix Titling" size="42.0" />
                            </font>
                        </Label>

                                                                                                <Label layoutX="109.0" layoutY="50.0" prefHeight="55.0" prefWidth="180.0" text="Vision" textFill="#f39838">
                            <font>
                                <Font name="Felix Titling" size="45.0" />
                            </font>
                            <effect>
                                <DropShadow color="#ffd94ec7" height="0.0" radius="0.8625" spread="0.28" width="5.45" />
                            </effect>
                        </Label>

                                                                                            </children>
                </AnchorPane>
      <VBox fx:id="cardBox" alignment="CENTER_LEFT" cache="true" maxWidth="380.0" prefHeight="560.0" prefWidth="380.0" spacing="20.0" style="-fx-border-radius: 12px; -fx-background-radius: 12px; -fx-border-color: linear-gradient(to right,#16243a,#f38983); -fx-border-width: 3px; -fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 8);">
      
                                                                                            <padding>
                        <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
                    </padding>
      
                                                                                            <children>
      
                                                                                                <Label fx:id="lblSignIn" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16243A;" text="Sign In" />
      
                                                                                                <VBox spacing="6.0">
                            <children>
      
                                                                                                        <Label fx:id="lblEmailTitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #16243A;" text="Email or Phone Number" />
      
                                                                                                        <TextField fx:id="txtEmailPhnumber" promptText="Enter your email or phone" style="-fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 10px; -fx-background-color: #F8FAFC;" />
      
                                                                                                    </children>
                        </VBox>
      
                                                                                                <VBox spacing="6.0">
                            <children>
      
                                                                                                        <Label fx:id="lblPassTitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #16243A;" text="Password" />
      
                                                                                                        <PasswordField fx:id="txtPassword" promptText="Enter your password" style="-fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 10px; -fx-background-color: #F8FAFC;" />
      
                                                                                                        <Hyperlink prefHeight="29.0" prefWidth="158.0" style="-fx-text-fill: #F39838; -fx-font-size: 13px; -fx-font-weight: bold; -fx-underline: false;" text="forget password?" />
      
                                                                                                    </children>
                        </VBox>
      
                                                                                                <VBox prefHeight="64.0" prefWidth="310.0">
                            <children>
      
                                                                                                        <CheckBox fx:id="cbDriver" style="-fx-font-size: 13px; -fx-text-fill: #16243A; -fx-font-weight: bold;" text="I am a Driver">
                                    <padding>
                                        <Insets bottom="10.0" />
                                    </padding>
                                </CheckBox>
      
                                                                                                        <Label fx:id="lbl1" prefHeight="52.0" prefWidth="310.0" style="-fx-text-fill: #22c55e;" text="*Drivers are registered by administrator only." />
      
                                                                                                        <Label fx:id="lbl2" style="-fx-text-fill: #22c55e;" text="Click if you are driver.*" />
      
                                                                                                    </children>
                        </VBox>
      
                                                                                                <VBox spacing="12.0" style="-fx-padding: 10px 0 0 0;">
                            <children>
      <Button fx:id="clickLogin" maxWidth="1.7976931348623157E308" onAction="#btnLogin" prefHeight="42.0" prefWidth="240.0" style="-fx-background-color: #16243A; -fx-text-fill: #F39838; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-border-color: linear-gradient(to left,#ffa500,#A36A00); -fx-border-radius: 8px; -fx-cursor: hand;" text="Log In" />
      
                                                                                                        <HBox alignment="CENTER" spacing="5.0">
                                    <children>
      
                                                                                                                <Label fx:id="lblNoAccount" style="-fx-text-fill: #16243A; -fx-font-size: 13px;" text="Don't have an account?" />
      
                                                                                                                <Hyperlink fx:id="regLink" onAction="#clickReg" style="-fx-text-fill: #F39838; -fx-font-size: 13px; -fx-font-weight: bold; -fx-underline: false;" text="Register here" />
      
                                                                                                            </children>
                                </HBox>
      
                                                                                                    </children>
                        </VBox>
      
                                                                                            </children>
                </VBox>
            <ImageView fitHeight="136.0" fitWidth="449.0" opacity="0.26" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../image/yangon-black.jpg" />
               </image>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </ImageView>

                                                                                    </children>
        </VBox>

        <!-- Top Right Buttons -->

        <HBox alignment="CENTER_RIGHT" maxHeight="40.0" maxWidth="160.0" spacing="8.0" StackPane.alignment="TOP_RIGHT">

            <StackPane.margin>
                <Insets right="20.0" top="15.0" />
            </StackPane.margin>

            <children>

                <Button fx:id="btnThemeToggle" mnemonicParsing="false" onAction="#handleThemeToggle" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #16243A; -fx-border-radius: 15px; -fx-border-color: #f38983; -fx-text-fill: #F39838; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 15px; -fx-cursor: hand;" text="🌙 Dark" />

                <Button fx:id="btnMaximize" mnemonicParsing="false" onAction="#handleMaximize" prefHeight="30.0" prefWidth="32.0" style="-fx-background-color: #ffffff; -fx-text-fill: #ffffff; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 15px; -fx-cursor: hand;" text="☐" />

            </children>
        </HBox>

    </children>
</StackPane>
